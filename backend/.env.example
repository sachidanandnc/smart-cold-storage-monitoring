PORT=5000

MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/your_database_name"
DEVICE_ID=cold-storage-01
# Use a unique random secret of at least 32 characters. Keep it out of Git.
DEVICE_API_KEY=replace-with-a-long-random-secret
# Dashboard reads are public; ESP sensor uploads require DEVICE_API_KEY.
# Comma-separated browser origins, without a trailing slash.
CORS_ORIGIN=http://localhost:5173
# Atlas Free: start replacing the oldest completed readings at this size.
# This is a rolling history, not a time-based expiry.
STORAGE_HIGH_WATER_MIB=420
STORAGE_LOW_WATER_MIB=380

TEMP_MIN=2
TEMP_MAX=8

HUMIDITY_MIN=40
HUMIDITY_MAX=80

DOOR_WARNING_SECONDS=10
DOOR_CRITICAL_SECONDS=20
